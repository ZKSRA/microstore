---
const featuredProduct = {
  name: "The Better Conversations Deck",
  price: "$29",
  description:
    "A cozy digital card deck with 120 thoughtful prompts for check-ins, date nights, and everyday moments that help you feel closer.",
  highlights: [
    "Quick mode for 5-minute connection moments",
    "Date night mode when you want a longer conversation",
    "Favorites tab so you can revisit meaningful prompts",
  ],
};

const howItWorks = [
  {
    title: "Discover",
    desc: "Find a deck from TikTok, Instagram, or through a friend and pick the one that matches your relationship vibe.",
  },
  {
    title: "Get access",
    desc: "Complete checkout once and receive your private link instantly by email.",
  },
  {
    title: "Use together",
    desc: "Open it on your phones and answer in turns, whether you're on the couch or long distance.",
  },
];

const benefits = [
  {
    title: "Gentle prompts",
    desc: "Questions are thoughtful, clear, and natural—so the conversation flows without feeling forced.",
  },
  {
    title: "Little rituals",
    desc: "Use weekly check-ins to stay in sync and create simple habits that keep you connected.",
  },
  {
    title: "Made to reuse",
    desc: "Come back any time: busy weekdays, cozy nights in, or whenever you want to reconnect.",
  },
];

const productPreviews = [
  {
    tag: "Tonight's card",
    title: "What helped you feel supported by me this week?",
    detail: "Tap for a warm follow-up and take turns answering.",
  },
  {
    tag: "Date night",
    title: "Choose a mood: playful, deeper, or future plans",
    detail: "Pick a category and let the deck guide the flow.",
  },
  {
    tag: "Weekly check-in",
    title: "How connected did we feel from 1 to 10?",
    detail: "Share one tiny action to make next week even better.",
  },
];

const testimonials = [
  {
    quote:
      "This made our evenings feel softer. We talk with more ease now, even after busy days.",
    author: "A & J · dating for 2 years",
  },
  {
    quote:
      "It's cute, calm, and actually useful. Our Sunday check-in became our favorite ritual.",
    author: "M & R · married",
  },
  {
    quote:
      "Perfect when we want quality time but don't want to overthink what to do.",
    author: "K & D · engaged",
  },
];

const faqs = [
  {
    q: "Is this a physical product?",
    a: "Nope—everything is digital. You'll use it from your phone, tablet, or laptop.",
  },
  {
    q: "How do we access it?",
    a: "Right after checkout, you'll receive a private access link by email. Open it and start together.",
  },
  {
    q: "Can we use it on our phones?",
    a: "Yes. It's designed mobile-first, with tap-friendly cards and clear spacing for small screens.",
  },
  {
    q: "Is it good for date night?",
    a: "Absolutely. It's great for date nights, chill evenings in, or quick check-ins during the week.",
  },
  {
    q: "Is it suitable for married / engaged / serious couples?",
    a: "Yes. It's made for committed couples in different stages—serious dating, engaged, or married.",
  },
